{
  "name": "glenc-regiebericht",
  "version": "1.0.0",
  "description": "Regieberichte für Glenc Innenausbau GmbH",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Glenc Innenausbau GmbH",
  "scripts": {
    "start": "npx serve .",
    "test": "node --check app.js && node --check electron/main.cjs",
    "web:build": "node scripts/prepare-web.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "android:sync": "node scripts/prepare-android.mjs && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.glencinnenausbau.regiebericht",
    "productName": "Glenc Regiebericht",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "manifest.webmanifest",
      "assets/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Glenc-Regiebericht-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glenc Regiebericht"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "jspdf": "4.2.1"
  }
}
